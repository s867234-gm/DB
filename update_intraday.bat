@echo off
setlocal
cd /d "%~dp0"

echo ======================================================================
echo   A_DB 数据库【盘中实时分钟线】增量更新脚本
echo   (仅同步当天已产生的 15 分钟线与动态 KDJ，日线自动隔离防污染)
echo ======================================================================
echo 正在执行盘中实时增量同步，请稍候...
echo.

python scripts\run_daily_update.py --allow-intraday %*

if %ERRORLEVEL% equ 0 (
    echo.
    echo ======================================================================
    echo   [成功] 盘中实时分钟线增量更新顺利完成！
    echo   提示: 15:00 收盘后请运行 update_db.bat 完成收盘日线与全天分钟线正式归档。
    echo ======================================================================
) else (
    echo.
    echo ======================================================================
    echo   [错误] 更新过程中遇到异常，请查看上方输出或 logs 目录中的日志。
    echo ======================================================================
)

pause
