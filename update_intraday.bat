@echo off
setlocal
cd /d "%~dp0"

echo ======================================================================
echo   A_DB 数据库【盘中实时分钟线】增量更新 (24线程高速并发版, 批次500)
echo   (自动同步最新已走完 15 分钟K线与动态 KDJ，日线不入库)
echo ======================================================================
echo 正在执行实时数据同步，请稍候...
echo.

python scripts\run_daily_update.py --allow-intraday --workers 24 --batch-size 500 %*

if %ERRORLEVEL% equ 0 (
    echo.
    echo ======================================================================
    echo   [成功] 盘中实时分钟线更新完成！
    echo   提示: 15:00 收盘后请运行 update_db.bat 完成全天完整归档。
    echo ======================================================================
) else (
    echo.
    echo ======================================================================
    echo   [失败] 更新过程出现异常，请查看上方或 logs 目录中的日志。
    echo ======================================================================
)

pause
